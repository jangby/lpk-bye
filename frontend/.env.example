# Biarkan kosong jika Nginx melayani frontend dan meneruskan /api ke backend.
VITE_API_URL=

# URL webhook n8n publik untuk chat AI; nilai VITE_ terlihat oleh pengunjung situs.
# Webhook menerima POST JSON dengan action, chatInput, dan sessionId; balasan JSON dapat memakai key output.
VITE_N8N_CHAT_WEBHOOK_URL=
